// 1. Base File: input.json
[
  {"order_id": 1, "email": "alice@example.com", "message": "Order confirmed!"},
  {"order_id": 2, "email": "bob@example.com", "message": "Your order has shipped!"},
  {"order_id": 3, "email": "carol@example.com", "message": "Your package was delivered!"},
  {"order_id": 4, "email": "dave@example.com", "message": "Order dispatched!"},
  {"order_id": 5, "email": "eve@example.com", "message": "Order confirmed!"}
]

// [Producer] Queuing order #1
// [Worker 1] Processing order #1
// [Dispatcher] Sending message to alice@example.com...
// [Producer] Queuing order #2
// [Worker 2] Processing order #2
// [Dispatcher] Sending message to bob@example.com...
// [Producer] Queuing order #3
// [Worker 0] Processing order #3
// [Dispatcher] Sending message to carol@example.com...
// [Dispatcher] Failed delivery
// [Dispatcher] Failed delivery
// [Dispatcher] Failed delivery

// All orders processed. Check notifications.db for logs.


// 2. Scenario: Multiple Orders for Multi-Threading
// [
//   {"order_id": 1, "email": "alice@example.com", "message": "Order confirmed!"},
//   {"order_id": 2, "email": "bob@example.com", "message": "Your order has shipped!"},
//   {"order_id": 3, "email": "carol@example.com", "message": "Your package was delivered!"},
//   {"order_id": 4, "email": "dave@example.com", "message": "Order dispatched!"},
//   {"order_id": 5, "email": "eve@example.com", "message": "Order confirmed!"}
// ]
// Purpose: Test multi-threading, concurrency, and worker pool processing.
// Concepts: Thread-safe queue, multi-threaded workers, concurrent dispatching.

